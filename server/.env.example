# Copy this file to .env and fill in the values. Never commit the real .env.

# Port the API listens on
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=

# Secret used to sign login tokens (use a long random string)
JWT_SECRET=

# Key for encrypting payment details. Create it with: node scripts/make-key.mjs
# Keep it secret, back it up, and never change it once data is stored.
PAYMENT_ENCRYPTION_KEY=

# Address of the React app
CLIENT_URL=http://localhost:5173